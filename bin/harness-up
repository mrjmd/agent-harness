#!/usr/bin/env bash
#
# harness-up: Updates the harness in the current project from the master source
#
# Usage:
#   harness-up              # Run from any project directory
#   harness-up --dry-run    # Preview what would be synced
#
# This script syncs the harness code from your master agent-harness repo
# without touching project-specific files (specs/, .claude/CLAUDE.md, etc.)
#

set -euo pipefail

# Determine the master harness source (where this script lives)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HARNESS_SOURCE="$(dirname "$SCRIPT_DIR")"

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() { echo -e "${BLUE}[SYNC]${NC} $1"; }
log_success() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[SKIP]${NC} $1"; }

# Parse args
DRY_RUN=""
if [[ "${1:-}" == "--dry-run" ]]; then
    DRY_RUN="--dry-run"
    echo -e "${YELLOW}DRY RUN MODE - No files will be changed${NC}"
    echo ""
fi

# Validate we're in a harness-enabled project
if [[ ! -d ".claude" ]] && [[ ! -d "harness" ]]; then
    echo "Error: Not in a harness-enabled project directory."
    echo "Expected to find .claude/ or harness/ directory."
    echo ""
    echo "To initialize a new project, run:"
    echo "  harness-init /path/to/project"
    exit 1
fi

echo ""
echo "=========================================="
echo "  Agent Harness - Update"
echo "=========================================="
echo ""
log_info "Source: $HARNESS_SOURCE"
log_info "Target: $(pwd)"
echo ""

# Ensure harness directory exists
mkdir -p harness/coding harness/reviewers harness/templates

# 1. Sync core harness files (OVERWRITE)
# These are the "engine" - always take latest
log_info "Syncing core harness files..."
rsync -av $DRY_RUN \
    "$HARNESS_SOURCE/harness/architect.py" \
    "$HARNESS_SOURCE/harness/archaeologist.py" \
    "$HARNESS_SOURCE/harness/doctor.py" \
    "$HARNESS_SOURCE/harness/review_board.py" \
    "$HARNESS_SOURCE/harness/memory.py" \
    ./harness/

# 2. Sync coding loop files (OVERWRITE)
log_info "Syncing coding loop..."
rsync -av $DRY_RUN \
    "$HARNESS_SOURCE/harness/coding/loop.py" \
    "$HARNESS_SOURCE/harness/coding/mcp_manager.py" \
    "$HARNESS_SOURCE/harness/coding/verify.py" \
    "$HARNESS_SOURCE/harness/coding/git_utils.py" \
    "$HARNESS_SOURCE/harness/coding/repo_map.py" \
    "$HARNESS_SOURCE/harness/coding/reflection.py" \
    "$HARNESS_SOURCE/harness/coding/review.py" \
    ./harness/coding/

# 3. Sync reviewers module (OVERWRITE)
log_info "Syncing reviewers..."
rsync -av $DRY_RUN --delete \
    --exclude '__pycache__' \
    "$HARNESS_SOURCE/harness/reviewers/" \
    ./harness/reviewers/

# 4. Sync templates (ADD NEW ONLY - don't overwrite customized ones)
log_info "Syncing templates (new files only)..."
rsync -av $DRY_RUN --ignore-existing \
    "$HARNESS_SOURCE/harness/templates/" \
    ./harness/templates/

# 5. Sync .claude/CLAUDE.md ONLY if it doesn't exist or is identical to source
# (This is the "constitution" - projects may customize it)
if [[ ! -f ".claude/CLAUDE.md" ]]; then
    log_info "Creating .claude/CLAUDE.md..."
    mkdir -p .claude
    rsync -av $DRY_RUN "$HARNESS_SOURCE/.claude/CLAUDE.md" ./.claude/
elif diff -q "$HARNESS_SOURCE/.claude/CLAUDE.md" ".claude/CLAUDE.md" > /dev/null 2>&1; then
    log_info "Updating .claude/CLAUDE.md (unchanged from source)..."
    rsync -av $DRY_RUN "$HARNESS_SOURCE/.claude/CLAUDE.md" ./.claude/
else
    log_warn ".claude/CLAUDE.md has local customizations, skipping"
fi

# 6. Ensure required directories exist
mkdir -p specs/memory specs/context tests/e2e

echo ""
echo "=========================================="
log_success "Harness updated to latest version!"
echo "=========================================="
echo ""

# Show what was preserved
echo "Preserved (not touched):"
echo "  - specs/features.json"
echo "  - specs/learnings.json"
echo "  - specs/memory/*"
echo "  - .claude/config.json"
echo "  - Any customized templates"
echo ""
