{
  "learnings": [],
  "_schema": {
    "learning": {
      "id": {
        "type": "string",
        "description": "Unique identifier (e.g., learn-feature-id-1)"
      },
      "timestamp": {
        "type": "string",
        "format": "date-time",
        "description": "When the lesson was learned"
      },
      "feature_id": {
        "type": "string",
        "description": "Which feature this lesson came from"
      },
      "category": {
        "type": "string",
        "enum": ["api_gotcha", "package_issue", "pattern", "environment", "test_insight", "other"],
        "description": "Category of the lesson"
      },
      "lesson": {
        "type": "string",
        "description": "The actual lesson learned (specific and actionable)"
      },
      "context": {
        "type": "string",
        "description": "Additional context about when/why this matters"
      }
    }
  },
  "_examples": [
